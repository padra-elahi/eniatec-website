# Password for the admin panel at /admin/. Leave unset and the panel stays
# locked (the login page says it is not configured). Use a long random value.
ADMIN_PASSWORD=

# Key that signs admin session cookies. Any long random string, e.g. the output
# of `openssl rand -base64 32`. If unset it is derived from ADMIN_PASSWORD, so
# setting it separately just means a password change does not depend on it.
SESSION_SECRET=

# Where the SQLite file with collaboration requests is kept. The Docker image
# sets this to /data (a volume); for `npm run dev` it defaults to ./data.
# DATA_DIR=./data

# Optional: a form backend for the short contact form on the home page that
# accepts a JSON POST (Formspree, Getform, …). When unset, that form opens the
# visitor's mail client instead. The full collaboration form at /collaborate/
# always stores requests in the admin panel and does not use this.
# NEXT_PUBLIC_CONTACT_ENDPOINT=https://formspree.io/f/xxxxxxx

# Admin cookies are marked Secure in production, which is right behind HTTPS.
# Only for a quick test over plain http://<server-ip>:8080, set this to false.
# COOKIE_SECURE=false
