# Standalone Caddy config for serving this site on your own server.
# Caddy obtains and renews the TLS certificate on its own — there is no
# certbot step, and no HTTP→HTTPS redirect to write: it does both by default.
#
#   sudo cp deploy/Caddyfile /etc/caddy/Caddyfile
#   sudo rsync -a --delete out/ /var/www/eniatec/
#   sudo systemctl reload caddy
#
# Requires ports 80 and 443 reachable from the internet for the ACME challenge,
# and eniatec.tech's A record already pointing at this server.

eniatec.tech, www.eniatec.tech {
	root * /var/www/eniatec
	encode gzip zstd

	@static path /_next/static/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	try_files {path} {path}/ {path}.html /index.html
	file_server

	handle_errors {
		@404 expression {err.status_code} == 404
		rewrite @404 /404.html
		file_server
	}
}
