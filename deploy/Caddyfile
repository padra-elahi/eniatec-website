# Standalone Caddy config for a plain server running this site's container
# (`docker compose up -d --build` from the repository root, which listens on
# 127.0.0.1:8080). Caddy obtains and renews the TLS certificate on its own and
# redirects HTTP to HTTPS by default.
#
#   sudo cp deploy/Caddyfile /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# Requires ports 80 and 443 reachable from the internet for the ACME challenge,
# and eniatec.tech's A record already pointing at this server.

eniatec.tech, www.eniatec.tech {
	encode gzip zstd
	reverse_proxy 127.0.0.1:8080
}
